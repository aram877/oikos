# Copy this file to .env.local and fill in your Supabase project values.
# Get these from: https://supabase.com/dashboard/project/phqdrliomclwjhnixicj/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://phqdrliomclwjhnixicj.supabase.co

# "anon" / "public" key from the API settings page
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only — NEVER prefix with NEXT_PUBLIC_
# "service_role" key from the API settings page (click "Reveal")
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The public URL of your deployed app (used in invitation redirect URLs).
# In development this defaults to http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase DB password (used for direct DB connections if needed, not by the app)
SUPABASE_PASSWORD=4WtgBAJnBZ9dPPGH
